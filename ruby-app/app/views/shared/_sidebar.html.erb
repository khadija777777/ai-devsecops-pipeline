<!-- ===== CSS à mettre dans votre <head> ou fichier de styles ===== -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  :root{
    --bg-app: #060a14;
    --bg-sidebar-top: #0b1226;
    --bg-sidebar-bot: #070c1a;
    --bg-panel: #0f1a34;
    --bg-panel-hover: #13214a;
    --border-soft: rgba(94,140,255,0.12);
    --border-strong: rgba(94,140,255,0.28);
    --accent: #3d7dff;
    --accent-bright: #5b9dff;
    --accent-glow: rgba(61,125,255,0.35);
    --success: #22c55e;
    --text-primary: #e7ecf7;
    --text-secondary: #8291b3;
    --text-muted: #5a6785;
    --font-ui: 'Inter', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }

  .sidebar{
    width: 272px;
    height: 100vh;
    position: sticky;
    top: 0;
    align-self: flex-start;
    flex-shrink: 0;
    display:flex;
    flex-direction:column;
    background: linear-gradient(180deg, var(--bg-sidebar-top) 0%, var(--bg-sidebar-bot) 100%);
    border-right: 1px solid var(--border-soft);
    overflow:hidden;
    font-family: var(--font-ui);
    color: var(--text-primary);
  }

  .sidebar::before{
    content:"";
    position:absolute;
    top:0; left:0; right:0;
    height:2px;
    background: linear-gradient(90deg, transparent, var(--accent-bright), transparent);
    animation: scan 4s linear infinite;
    opacity:.6;
  }
  @keyframes scan{
    0%{ transform:translateX(-100%); }
    100%{ transform:translateX(100%); }
  }

  /* ============ LOGO ============ */
  .logo{
    padding: 32px 24px 20px;
    text-align:center;
    position:relative;
    flex-shrink:0;
  }

  .logo-badge{
    width:64px; height:64px;
    margin:0 auto 14px;
    border-radius:16px;
    display:flex; align-items:center; justify-content:center;
    background: radial-gradient(circle at 30% 30%, rgba(61,125,255,0.25), rgba(61,125,255,0.05));
    border:1px solid var(--border-strong);
    box-shadow: 0 0 24px var(--accent-glow);
  }

  .logo-badge i{
    font-size: 28px;
    color: var(--accent-bright);
  }

  .logo h4{
    font-weight:800;
    font-size: 18px;
    letter-spacing: 0.3px;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .logo .subtitle{
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .logo hr{
    border: none;
    height:1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
    margin:0;
  }

  /* ============ MENU ============ */
  .menu{
    list-style:none;
    flex:1;
    padding: 18px 14px;
    display:flex;
    flex-direction:column;
    gap: 3px;
    overflow-y:auto;
    margin:0;
    min-height:0;
  }

  .menu li a{
    display:flex;
    align-items:center;
    gap: 13px;
    padding: 11px 14px;
    border-radius: 10px;
    text-decoration:none;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 500;
    position: relative;
    transition: color .18s ease, background-color .18s ease;
  }

  .menu li a i{
    font-size: 17px;
    width: 20px;
    text-align:center;
    color: var(--text-muted);
    transition: color .18s ease;
  }

  .menu li a:hover{
    background: var(--bg-panel);
    color: var(--text-primary);
  }
  .menu li a:hover i{ color: var(--accent-bright); }

  .menu li a.active{
    background: linear-gradient(90deg, rgba(61,125,255,0.16), rgba(61,125,255,0.02));
    color: var(--text-primary);
    font-weight:600;
  }
  .menu li a.active i{ color: var(--accent-bright); }

  .menu li a.active::before{
    content:"";
    position:absolute;
    left:-14px;
    top:8px; bottom:8px;
    width:3px;
    border-radius: 0 4px 4px 0;
    background: var(--accent-bright);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .badge-live{
    margin-left:auto;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight:600;
    padding: 2px 7px;
    border-radius: 20px;
    background: rgba(34,197,94,0.12);
    color: var(--success);
    border: 1px solid rgba(34,197,94,0.3);
  }

  /* ============ USER CARD ============ */
  .user-panel{
    padding: 16px;
    margin: 0 14px 18px;
    border-radius: 14px;
    background: var(--bg-panel);
    border: 1px solid var(--border-soft);
    display:flex;
    align-items:center;
    gap: 12px;
    flex-shrink:0;
  }

  .user-avatar{
    position:relative;
    width:42px; height:42px;
    border-radius:10px;
    background: linear-gradient(135deg, rgba(61,125,255,0.3), rgba(61,125,255,0.05));
    border: 1px solid var(--border-strong);
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }
  .user-avatar i{ font-size:19px; color: var(--accent-bright); }

  .status-dot{
    position:absolute;
    bottom:-2px; right:-2px;
    width:11px; height:11px;
    border-radius:50%;
    background: var(--success);
    border: 2px solid var(--bg-panel);
    box-shadow: 0 0 8px rgba(34,197,94,0.7);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse{
    0%,100%{ opacity:1; }
    50%{ opacity:.55; }
  }

  .user-info h6{
    font-size:13.5px;
    font-weight:600;
    color: var(--text-primary);
    margin-bottom:2px;
  }
  .user-info span{
    font-family: var(--font-mono);
    font-size:10.5px;
    color: var(--success);
    display:flex; align-items:center; gap:5px;
  }

  .menu::-webkit-scrollbar{ width:5px; }
  .menu::-webkit-scrollbar-thumb{ background: var(--border-strong); border-radius:4px; }
</style>

<!-- ===== HTML de la sidebar ===== -->
<!-- ===== HTML de la sidebar ===== -->
<div class="sidebar">

    <div class="logo">
        <div class="logo-badge">
            <i class="bi bi-shield-lock-fill"></i>
        </div>

        <h4>AI DevSecOps</h4>
        <p class="subtitle">Security Operations Center</p>
        <hr>
    </div>

    <ul class="menu">

        <li>
            <a href="/ads" class="active">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>
        </li>

        <li>
            <a href="/ads">
                <i class="bi bi-hdd-network"></i>
                Assets
            </a>
        </li>

        <li>
            <a href="#">
                <i class="bi bi-shield-check"></i>
                Security Center
            </a>
        </li>

        <li>
            <a href="#">
                <i class="bi bi-diagram-3"></i>
                Pipeline
            </a>
        </li>

        <li>
            <a href="#">
                <i class="bi bi-file-earmark-bar-graph"></i>
                Reports
            </a>
        </li>

        <li>
            <a href="#">
                <i class="bi bi-robot"></i>
                AI Analysis
                <span class="badge-live">LIVE</span>
            </a>
        </li>

        <% if user_signed_in? && current_user.admin? %>
            <li>
                <a href="#">
                    <i class="bi bi-people"></i>
                    Users
                </a>
            </li>

            <li>
                <a href="#">
                    <i class="bi bi-gear"></i>
                    Settings
                </a>
            </li>
        <% end %>

    </ul>

    <% if user_signed_in? %>

    <div class="user-panel">

        <div class="user-avatar">
            <i class="bi bi-person-fill"></i>
            <span class="status-dot"></span>
        </div>

        <div class="user-info">

            <h6><%= current_user.email %></h6>

            <span>
                <% if current_user.admin? %>
                    Administrator
                <% else %>
                    Security Analyst
                <% end %>
            </span>

        </div>

    </div>

    <div style="padding:15px;">
        <%= button_to "Logout",
            destroy_user_session_path,
            method: :delete,
            class: "btn btn-danger w-100" %>
    </div>

    <% end %>

</div>
