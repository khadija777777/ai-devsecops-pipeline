<style>
  .auth-page{
    --bg-deep: #05080f;
    --bg-sidebar-top: #0b1226;
    --bg-panel: #0f1a34;
    --bg-panel-2: #0c1730;
    --bg-input: #0a1428;
    --bg-card-glass: rgba(20,32,60,0.85);
    --border-soft: rgba(94,140,255,0.14);
    --border-strong: rgba(94,140,255,0.32);
    --accent: #3d7dff;
    --accent-bright: #5b9dff;
    --accent-glow: rgba(61,125,255,0.35);
    --success: #22c55e;
    --success-glow: rgba(34,197,94,0.25);
    --text-primary: #e7ecf7;
    --text-secondary: #8291b3;
    --text-muted: #5a6785;
    --font-ui: 'Inter', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;

    min-height:100vh;
    display:flex;
    flex-direction:column;
    font-family: var(--font-ui);
    background: var(--bg-deep);
    position:relative;
    overflow:hidden;
  }

  .auth-main{ flex:1; display:flex; }

  /* ============ FOND TEXTURÉ ============ */
  .auth-bg-glow{ position:absolute; border-radius:50%; filter: blur(90px); pointer-events:none; z-index:0; }
  .auth-bg-glow.g1{ width:520px; height:520px; top:-160px; left:-120px; background: radial-gradient(circle, rgba(61,125,255,0.28), transparent 70%); }
  .auth-bg-glow.g2{ width:460px; height:460px; bottom:-180px; left:30%; background: radial-gradient(circle, rgba(34,197,94,0.14), transparent 70%); }
  .auth-bg-grid{
    position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(94,140,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(94,140,255,0.05) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 40%, black 40%, transparent 85%);
    z-index:0;
  }
  .auth-page::before{
    content:"";
    position:absolute; top:0; left:0; right:0; height:2px;
    background: linear-gradient(90deg, transparent, var(--accent-bright), transparent);
    animation: scan 4.5s linear infinite;
    opacity:.55; z-index:2;
  }
  @keyframes scan{ 0%{transform:translateX(-100%);} 100%{transform:translateX(100%);} }

  /* ============ COLONNE GAUCHE ============ */
  .auth-left{ flex:1; display:flex; flex-direction:column; justify-content:center; padding:70px 60px; color: var(--text-primary); position:relative; z-index:1; }
  .auth-left-inner{ max-width:560px; width:100%; }
  .auth-header{ display:flex; align-items:center; gap:20px; margin-bottom:38px; }

  .auth-logo-badge{
    width:72px; height:72px; border-radius:18px;
    display:flex; align-items:center; justify-content:center;
    background: radial-gradient(circle at 30% 30%, rgba(61,125,255,0.35), rgba(61,125,255,0.06));
    border:1px solid var(--border-strong);
    box-shadow: 0 0 40px var(--accent-glow);
    font-size:30px; color: var(--accent-bright); flex-shrink:0;
  }

  .auth-left h1{ font-size:36px; font-weight:800; letter-spacing:-0.5px; color: var(--text-primary); line-height:1.1; }
  .auth-left .eyebrow{ font-family: var(--font-mono); font-weight:500; font-size:11.5px; letter-spacing:1.6px; text-transform:uppercase; color: var(--text-muted); margin-top:4px; }

  /* ============ STATS ROW (animées) ============ */
  .auth-stats{ display:grid; grid-template-columns: repeat(3, 1fr); gap:14px; margin-bottom:26px; }
  .auth-stat{ background: var(--bg-panel); border:1px solid var(--border-soft); border-radius:14px; padding:16px 14px; }
  .auth-stat .num{ font-family: var(--font-mono); font-size:22px; font-weight:600; color: var(--accent-bright); display:flex; align-items:baseline; gap:4px; }
  .auth-stat .num small{ font-size:12px; color: var(--text-muted); font-weight:500; }
  .auth-stat .label{ font-size:11.5px; color: var(--text-secondary); margin-top:4px; }

  /* ============ TERMINAL LIVE FEED ============ */
  .auth-terminal{ background: var(--bg-panel-2); border:1px solid var(--border-soft); border-radius:14px; margin-bottom:26px; overflow:hidden; }
  .auth-terminal-bar{ display:flex; align-items:center; gap:8px; padding:11px 16px; border-bottom:1px solid var(--border-soft); background: rgba(255,255,255,0.015); }
  .auth-terminal-dot{ width:9px; height:9px; border-radius:50%; }
  .auth-terminal-dot.r{ background:#ef4444; }
  .auth-terminal-dot.y{ background:#eab308; }
  .auth-terminal-dot.g{ background:#22c55e; }
  .auth-terminal-title{ font-family: var(--font-mono); font-size:11px; color: var(--text-muted); margin-left:6px; }
  .auth-terminal-live{ margin-left:auto; display:flex; align-items:center; gap:6px; font-family: var(--font-mono); font-size:10px; color: var(--success); }
  .auth-terminal-live .dot{ width:6px; height:6px; border-radius:50%; background: var(--success); box-shadow:0 0 6px var(--success-glow); animation: pulse 1.8s ease-in-out infinite; }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:.4;} }

  .auth-terminal-body{ height:158px; overflow:hidden; position:relative; padding:14px 16px; font-family: var(--font-mono); font-size:12px; line-height:1.9; }
  .auth-terminal-body p{ white-space:nowrap; opacity:0; animation: lineIn .4s ease forwards; }
  .auth-terminal-body .ok{ color: var(--success); }
  .auth-terminal-body .info{ color: var(--accent-bright); }
  .auth-terminal-body .path{ color: var(--text-secondary); }
  .auth-terminal-body .time{ color: var(--text-muted); margin-right:8px; }
  @keyframes lineIn{ from{ opacity:0; transform:translateY(6px);} to{ opacity:1; transform:translateY(0);} }

  /* ============ FEATURES GRID ============ */
  .auth-features{ display:grid; grid-template-columns: repeat(2, 1fr); gap:10px; }
  .auth-feature{ display:flex; align-items:center; gap:11px; font-size:14px; color: var(--text-secondary); background: rgba(255,255,255,0.02); border:1px solid var(--border-soft); border-radius:10px; padding:11px 13px; }
  .auth-feature-check{ width:22px; height:22px; border-radius:6px; background: var(--success-glow); border:1px solid rgba(34,197,94,0.35); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .auth-feature-check i{ font-size:11px; color: var(--success); }

  /* ============ COLONNE DROITE ============ */
  .auth-right{ width:560px; display:flex; justify-content:center; align-items:center; padding:60px 48px; position:relative; z-index:1; }

  .auth-card{
    width:420px;
    background: var(--bg-card-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border:1px solid var(--border-soft);
    border-radius:20px;
    padding:44px 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    position:relative;
    overflow:hidden;
  }
  .auth-card::before{ content:""; position:absolute; top:0; left:0; right:0; height:1px; background: linear-gradient(90deg, transparent, var(--accent-bright), transparent); }

  .auth-card h2{ font-weight:700; font-size:25px; color: var(--text-primary); margin-bottom:6px; }
  .auth-card > p{ font-family: var(--font-mono); font-size:12px; letter-spacing:0.5px; color: var(--text-muted); margin-bottom:32px; }

  .auth-field{ margin-bottom:20px; }
  .auth-field label{ display:block; font-size:12.5px; font-weight:600; color: var(--text-secondary); margin-bottom:8px; }
  .auth-field input[type="email"], .auth-field input[type="password"]{
    width:100%; background: var(--bg-input); border:1px solid var(--border-soft); border-radius:10px;
    padding:14px 15px; font-size:15px; color: var(--text-primary); font-family: var(--font-ui);
    transition: border-color .18s ease, box-shadow .18s ease;
  }
  .auth-field input::placeholder{ color: var(--text-muted); }
  .auth-field input:focus{ outline:none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }

  .auth-remember{ display:flex; align-items:center; gap:9px; margin-bottom:28px; }
  .auth-remember input{ accent-color: var(--accent); width:15px; height:15px; }
  .auth-remember label{ font-size:13px; color: var(--text-secondary); margin:0; }

  .auth-submit{
    width:100%; display:flex; align-items:center; justify-content:center; gap:10px;
    background: linear-gradient(135deg, var(--accent), #2f66e0);
    border:none; border-radius:10px; padding:15px; font-size:15px; font-weight:600; color:#fff;
    box-shadow: 0 8px 24px var(--accent-glow);
    transition: transform .2s ease, box-shadow .2s ease;
    cursor:pointer; position:relative; overflow:hidden;
  }
  .auth-submit:hover{ transform: translateY(-3px); box-shadow: 0 14px 40px var(--accent-glow), 0 0 0 1px var(--border-strong); }
  .auth-submit::after{
    content:""; position:absolute; top:0; left:-60%; width:40%; height:100%;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.25), transparent);
    transform: skewX(-20deg); transition: left .5s ease;
  }
  .auth-submit:hover::after{ left:130%; }

  .auth-links{ margin-top:24px; text-align:center; font-size:13px; }
  .auth-links a{ color: var(--accent-bright); text-decoration:none; font-weight:500; }
  .auth-links a:hover{ text-decoration:underline; }

  /* ============ FOOTER ============ */
  .auth-footer{
    position:relative; z-index:1;
    padding:18px 60px;
    font-family: var(--font-mono);
    font-size:11px;
    color: var(--text-muted);
    display:flex;
    align-items:center;
    gap:10px;
    border-top:1px solid var(--border-soft);
  }
  .auth-footer .sep{ color: var(--border-strong); }
  .auth-footer strong{ color: var(--text-secondary); font-weight:600; }

  @media (max-width: 980px){
    .auth-main{ flex-direction:column; }
    .auth-right{ width:100%; }
    .auth-card{ width:100%; max-width:420px; }
    .auth-features{ grid-template-columns: 1fr; }
    .auth-footer{ padding:14px 24px; }
  }
</style>

<div class="auth-page">
  <div class="auth-bg-grid"></div>
  <div class="auth-bg-glow g1"></div>
  <div class="auth-bg-glow g2"></div>

  <div class="auth-main">

    <!-- Partie gauche -->
    <div class="auth-left">
        <div class="auth-left-inner">

            <div class="auth-header">
                <div class="auth-logo-badge">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <h1>AI DevSecOps</h1>
                    <p class="eyebrow">Security Operations Center</p>
                </div>
            </div>

            <div class="auth-stats">
                <div class="auth-stat">
                    <div class="num" data-target="99.9" data-suffix="%" data-decimals="1">0<small>%</small></div>
                    <div class="label">Uptime</div>
                </div>
                <div class="auth-stat">
                    <div class="num" data-target="247">0</div>
                    <div class="label">Scans / jour</div>
                </div>
                <div class="auth-stat">
                    <div class="num" data-target="12">0</div>
                    <div class="label">Menaces bloquées</div>
                </div>
            </div>

            <div class="auth-terminal">
                <div class="auth-terminal-bar">
                    <span class="auth-terminal-dot r"></span>
                    <span class="auth-terminal-dot y"></span>
                    <span class="auth-terminal-dot g"></span>
                    <span class="auth-terminal-title">live-pipeline.log</span>
                    <span class="auth-terminal-live"><span class="dot"></span>LIVE</span>
                </div>
                <div class="auth-terminal-body" id="terminalBody">
                    <!-- rempli dynamiquement en JS -->
                </div>
            </div>

            <div class="auth-features">
                <div class="auth-feature"><span class="auth-feature-check"><i class="bi bi-check-lg"></i></span>Docker Pipeline</div>
                <div class="auth-feature"><span class="auth-feature-check"><i class="bi bi-check-lg"></i></span>Jenkins CI/CD</div>
                <div class="auth-feature"><span class="auth-feature-check"><i class="bi bi-check-lg"></i></span>Trivy Security Scan</div>
                <div class="auth-feature"><span class="auth-feature-check"><i class="bi bi-check-lg"></i></span>Brakeman SAST</div>
                <div class="auth-feature"><span class="auth-feature-check"><i class="bi bi-check-lg"></i></span>Wazuh SIEM</div>
                <div class="auth-feature"><span class="auth-feature-check"><i class="bi bi-check-lg"></i></span>AI Vulnerability Analysis</div>
            </div>

        </div>
    </div>

    <!-- Partie droite -->
    <div class="auth-right">
        <div class="auth-card">

            <h2>Welcome Back</h2>
            <p>LOGIN TO CONTINUE</p>

            <%= form_for(resource,
                as: resource_name,
                url: session_path(resource_name)) do |f| %>

                <div class="auth-field">
                    <%= f.label :email %>
                    <%= f.email_field :email,
                        autofocus: true,
                        autocomplete: "email",
                        placeholder: "you@company.com" %>
                </div>

                <div class="auth-field">
                    <%= f.label :password %>
                    <%= f.password_field :password,
                        autocomplete: "current-password",
                        placeholder: "••••••••" %>
                </div>

                <% if devise_mapping.rememberable? %>
                    <div class="auth-remember">
                        <%= f.check_box :remember_me %>
                        <%= f.label :remember_me %>
                    </div>
                <% end %>

                <%= f.submit "Sign In", class: "auth-submit" %>

            <% end %>

            <div class="auth-links">
                <%= render "devise/shared/links" %>
            </div>

        </div>
    </div>

  </div>

  <!-- Footer -->
  <div class="auth-footer">
    <strong>EMSI Casablanca</strong>
    <span class="sep">•</span>
    <span>AI DevSecOps Platform</span>
    <span class="sep">•</span>
    <span>Version 1.0</span>
  </div>

</div>

<script>
(function(){
  // ---- 1. Compteurs animés (0 -> valeur) ----
  document.querySelectorAll('.auth-stat .num').forEach(function(el){
    var target = parseFloat(el.getAttribute('data-target'));
    var decimals = parseInt(el.getAttribute('data-decimals') || '0');
    var suffix = el.getAttribute('data-suffix') || '';
    var smallEl = el.querySelector('small');
    var duration = 1200;
    var start = null;

    function step(ts){
      if(!start) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      var value = (target * eased).toFixed(decimals);
      el.childNodes[0].nodeValue = value;
      if(progress < 1){ requestAnimationFrame(step); }
      else { el.childNodes[0].nodeValue = target.toFixed(decimals); }
    }
    // reconstruire le noeud texte + le <small> éventuel
    el.innerHTML = '';
    var textNode = document.createTextNode('0');
    el.appendChild(textNode);
    if(smallEl){ el.appendChild(smallEl); }
    requestAnimationFrame(step);
  });

  // ---- 2. Terminal : logs qui défilent et se renouvellent ----
  var logs = [
    { time:'10:42:03', tag:'ok',   label:'[OK]',  html:'Trivy scan <span class="path">web-app:latest</span> — 0 critical' },
    { time:'10:41:47', tag:'info', label:'[CI]',  html:'Jenkins build #482 passed' },
    { time:'10:41:12', tag:'ok',   label:'[OK]',  html:'Brakeman SAST — no vulnerabilities' },
    { time:'10:40:58', tag:'info', label:'[AI]',  html:'Anomaly score normalisé — 0.02' },
    { time:'10:40:21', tag:'ok',   label:'[OK]',  html:'Wazuh — 0 alerte critique' },
    { time:'10:39:55', tag:'info', label:'[CI]',  html:'Docker image poussée vers registry' },
    { time:'10:39:30', tag:'ok',   label:'[OK]',  html:'AI Vulnerability Analysis — scan terminé' },
    { time:'10:39:02', tag:'info', label:'[CI]',  html:'Pipeline #481 déclenché' }
  ];

  var body = document.getElementById('terminalBody');
  var visibleCount = 4;
  var idx = 0;

  function render(){
    body.innerHTML = '';
    for(var i = 0; i < visibleCount; i++){
      var log = logs[(idx + i) % logs.length];
      var p = document.createElement('p');
      p.style.animationDelay = (i * 0.08) + 's';
      p.innerHTML = '<span class="time">' + log.time + '</span><span class="' + log.tag + '">' + log.label + '</span> ' + log.html;
      body.appendChild(p);
    }
  }

  render();
  setInterval(function(){
    idx = (idx + 1) % logs.length;
    render();
  }, 2600);
})();
</script>
